{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: gcc 编译当前文件",
            "type": "cppbuild",
            "command":"gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\coin\\${fileBasenameNoExtension}.exe",
                "-fexec-charset=GBK"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher":[
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用 PATH 中的 gcc 编译当前 C 文件"
        }
    ]
}